{
    "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/refs/heads/master/packages/app-builder-lib/scheme.json",
    "appId": "com.bastiasa.digitalprojector",
    "productName": "Digital Projector",
    "artifactName": "dp.${ext}",


    "asar": false,

    "files": [
        "dist-website/**/*",
        "dist-electron/**/*",
        "dist-ui/**/*",
        "assets/**/*"
    ],

    "linux": {
        "icon": "icons/icon.png",
        "target": "AppImage"
    },
    
    "win": {
        "target": "nsis",
        "icon": "icons/icon.ico"
    }
}