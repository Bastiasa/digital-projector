{
  "name": "digital-projector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": {
    "name": "Luis Bastidas",
    "email": "leysantqm@gmail.com",
    "url": "https://bastiasa.github.io"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:ui": "vite",
    "dev:electron": "npm run build:electron && electron . --disable-vulkan --ozone-platform=x11",
    "dev": "npm run build && cross-env ENV_MODE=development npm-run-all -p dev:ui dev:electron",
    "!dev": "cross-env ENV_MODE=development npm-run-all -p dev:ui dev:electron",
    "build:ui": "tsc -b && vite build",
    "build:preload": "esbuild --bundle --platform=node --minify --external:electron --tsconfig=src/electron/preload/tsconfig.json --outfile=dist-electron/preload.cjs src/electron/preload/main.ts",
    "build:electron": "tsc -p ./src/electron/",
    "build:website": "cd packages/website && npm run build",
    "build:shared": "cd packages/shared && npm run build",
    
    "build:monorepo":"npm run build:shared && npm run build:website",
    
    "build": "npm run build:monorepo && npm-run-all -p build:ui build:electron build:preload",
    
    "dist:linux": "npm run build && electron-builder build -l  --publish never",
    "only:dist:linux": "electron-builder build -l --publish never",


    "dist:win": "npm run build && electron-builder build -w  --publish never",
    "only:dist:win": "electron-builder build -w",

    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@types/socket.io": "^3.0.1",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "electron-log": "^5.4.4",
    "fastify": "^5.11.0",
    "mime-types": "^3.0.2",
    "qrcode.react": "^4.2.0",
    "socket.io": "^4.8.3",
    "@digital-projector/shared": "workspace:*"
  }
}